# Copy to .env and fill in. Never commit .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=12
CORS_ORIGINS=http://localhost:5173
# Sends Abu Fadi's hidden confidence scores in a `debug` block. Spoilers - keep
# off except when tuning the prompt.
EXPOSE_DEBUG=false

# OpenAI (optional). Just the key - models are named in the request.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5          # only needed to change the default
# OPENAI_BASE_URL=              # point at any OpenAI-compatible service

# Azure OpenAI (optional). Two lines is all you need: the key, and the
# "Target URI" Azure shows next to your deployment (it already contains the
# resource, the deployment name and the api-version).
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_TARGET_URI=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2025-01-01-preview
#
# Or set the pieces yourself instead - these win if both are given:
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment name>
# AZURE_OPENAI_API_VERSION=2024-10-21
